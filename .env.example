# CampusKart - Environment Configuration Template
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to version control.

# Application Configuration
NEXT_PUBLIC_APP_NAME="CampusKart"
NEXT_PUBLIC_APP_URL="http://localhost:8000"

# Supabase Project Configuration
# Found in your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Server-Side Privileged Key (Used strictly for backend operations and atomic RPC transactions)
# NEVER expose this key to browser client bundles or public repositories.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Optional Direct PostgreSQL Connection (if using native pdo_pgsql or direct CLI)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres"

# Local MySQL Fallback Configuration (Optional)
DB_DRIVER="supabase"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="campuskart"
DB_USER="root"
DB_PASS=""
